# COS 开发环境默认配置（示例）
#
# 说明：
# - 复制为 .env 并按需填写（.env 已在 .gitignore 中忽略，不应提交）
# - 真实 token / api_secret 属于敏感信息，只允许保存在本地 .env
#

# 开发环境默认域名
COS_DEV_DOMAIN=cos-dev.junhai.work
# 本地开发（hosts 指向 127.0.0.1 且 nginx 未启用 TLS）时必须使用 http
COS_DEV_BASE_URL=http://cos-dev.junhai.work
# 若你在远端/生产启用了 TLS，再改成 https
# COS_DEV_BASE_URL=https://cos-dev.junhai.work

# FAC MCP Endpoint（StreamableHTTP / JSON-RPC 2.0）
FAC_MCP_URL=${COS_DEV_BASE_URL}/api/method/frappe_assistant_core.api.fac_endpoint.handle_mcp

# 鉴权方式（二选一）：
#
# 1) OAuth Bearer（推荐）
# FAC_AUTH_HEADER="Bearer <access_token>"
#
# 2) Legacy API key/secret（便于脚本快速调用）
# FAC_AUTH_HEADER="token <api_key>:<api_secret>"

# Outline（私有部署知识库）
OUTLINE_BASE_URL=https://outline.junhai.work
# 默认文档集（Collection）名称（包含空格时请加引号）
OUTLINE_DEFAULT_COLLECTION="COS 文档"
# OUTLINE_API_KEY=ol_api_xxx（不要提交真实值，写到本地 .env）

