  "content": "{% set company_logo = frappe.db.get_value(\"Company\", doc.company, \"company_logo\") %}\n\n<div style=\"width: 100%; color: #171717;\">\n    <table style=\"width: 100%; border-collapse: collapse; table-layout: fixed; border-bottom: none; margin: 0;\">\n        <tbody>\n            <tr>\n                <td style=\"vertical-align: middle !important; text-align: left; padding: 0 !important;\">\n                    <div style=\"line-height: 54px; font-size: 0; white-space: nowrap; display: flex; align-items: center;\">\n                        \n                        {% if company_logo %}\n                            <img src=\"{{ frappe.utils.get_url(company_logo) }}\" style=\"height: 44px !important; width: auto !important; max-width: none !important; display: inline-block !important; vertical-align: middle; flex-shrink: 0;\">\n                        {% else %}\n                            <img src=\"https://s3.junhai.work/cos-shared/cos_logo_t.svg\" style=\"height: 44px !important; width: auto !important; max-width: none !important; background: black; display: inline-block !important; vertical-align: middle; flex-shrink: 0;\">\n                        {% endif %}\n\n                        <span style=\"display: inline-block; width: 12px;\"></span>\n                        \n                        <span style=\"display: inline-block; vertical-align: middle; font-size: 18px; font-weight: bold; line-height: 1.2; color: #000; white-space: normal;\">\n                            {{ doc.company }}\n                        </span>\n                    </div>\n                </td>\n\n                <td style=\"vertical-align: middle !important; text-align: right; padding: 0 !important; width: 220px;\">\n                    <div style=\"font-size: 20px; font-weight: bold; color: #000; line-height: 1; margin-bottom: 5px;\">\n                        {{ _(doc.doctype) }}\n                    </div>\n                    <div style=\"font-size: 11px; color: #666; line-height: 1;\">\n                        <span style=\"color: #999;\">编号:</span>\n                        <span style=\"font-weight: bold; color: #333; font-family: Arial, sans-serif;\">{{ doc.name }}</span>\n                    </div>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n\n    <div style=\"height: 2px; background-color: #000; font-size: 0; line-height: 0; width: 100%;\"></div>\n</div>\n\n{# 水印 - 根据文档状态显示 #}\n{%- if doc.docstatus==2-%}\n<div class=\"text-center watermark\">\n    <h4>已作废</h4>\n</div>\n{%- endif -%}\n{%- if doc.docstatus==0 -%}\n<div class=\"text-center watermark\">\n    <h4>草稿</h4>\n</div>\n{%- endif -%}",
